# Docker Compose 环境变量
# 复制为 .env 并修改

# 数据库
MYSQL_ROOT_PASSWORD=xingyu_mysql_2026

# 安全密钥（务必修改为随机字符串）
SECRET_KEY=your-random-secret-key-here
JWT_SECRET_KEY=your-random-jwt-secret-here

# 前端访问地址（用于 CORS）
CORS_ORIGINS=https://your-domain.com

# 服务端口
APP_PORT=80

# 飞书配置
FEISHU_WEBHOOK_URL=
FEISHU_APP_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_CHAT_ID=
FEISHU_APP_VERIFICATION_TOKEN=
FEISHU_APP_ENCRYPT_KEY=
APPLICATION_ACTION_BASE_URL=https://your-domain.com

# 邮件配置
MAIL_ENABLED=false
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-smtp-password
MAIL_FROM_NAME=星雨作坊
SMTP_FROM=your-email@qq.com

# 站点链接
DEFAULT_GITHUB_URL=https://github.com/your-org
