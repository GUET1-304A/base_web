# Flask 配置
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=true

# MySQL 配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=xingyu_cms

# JWT 配置
JWT_SECRET_KEY=your-jwt-secret-key

# CORS 配置（前端地址，多个用逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 文件与请求配置
UPLOAD_FOLDER=D:\path\to\base_web\backend\uploads
MAX_CONTENT_LENGTH=10485760
APPLICATION_RATE_LIMIT_MINUTES=10

# 第三方服务配置
# 报名卡片交互（应用机器人）：飞书开放平台订阅 card.action.trigger，请求地址填：
#   https://你的API域名/api/feishu/cards/callback
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-token
FEISHU_APP_ENABLED=true
FEISHU_APP_ID=cli_xxxxx
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_APP_CHAT_ID=oc_xxxxx
FEISHU_APP_VERIFICATION_TOKEN=your-feishu-verification-token
FEISHU_APP_ENCRYPT_KEY=
FEISHU_HTTP_TIMEOUT=8
FEISHU_HTTP_RETRIES=0
FEISHU_HTTP_RETRY_BACKOFF_SECONDS=0.6
APPLICATION_ACTION_BASE_URL=https://your-domain.example.com
MAIL_ENABLED=true
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=false
SMTP_USE_SSL=true
MAIL_FROM_NAME=星雨作坊
SMTP_FROM=your-email@qq.com

# 站点默认链接配置
DEFAULT_GITHUB_URL=https://github.com/your-org-or-user
DEFAULT_APPLICATION_GITHUB_URL=https://github.com
